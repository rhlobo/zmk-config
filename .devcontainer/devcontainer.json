{
  "name": "ZMK Development",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "ZMK_URL": "https://github.com/urob/zmk.git",
      "ZMK_BRANCH": "main",
      "ZMK_PATH": "/zmk",
      // "ZMK_URL": "https://github.com/zmkfirmware/zmk.git",
      // "ZMK_BRANCH": "main",
      "USERNAME": "dev",
      "USER_UID": "${localEnv:UID:1000}",
      "USER_GID": "${localEnv:GID:1000}"
    }
  },
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "runArgs": ["--security-opt", "label=disable"],
  "updateContentCommand": "cd $ZMK_PATH && git fetch && git reset --hard origin/main && west update && west zephyr-export",
  "containerEnv": {
    "WORKSPACE_PATH": "${containerWorkspaceFolder}",
    "ZMK_PATH": "/zmk",
    "BUILD_SUBFOLDER": "build"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools", "spadin.zmk-tools"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
