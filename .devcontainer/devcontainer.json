{
  "name": "ZMK Development",
  "build": {
    // The context is the repo root so the Dockerfile can copy config/west.yml, the only
    // place a ZMK or module revision is written.
    "context": "..",
    "dockerfile": "Dockerfile",
    "args": {
      "USERNAME": "dev",
      "USER_UID": "${localEnv:UID:1000}",
      "USER_GID": "${localEnv:GID:1000}"
    }
  },
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "runArgs": ["--security-opt", "label=disable"],
  "updateContentCommand": "bin/west-sync",
  "containerEnv": {
    "WORKSPACE_PATH": "${containerWorkspaceFolder}",
    "ZMK_WORKSPACE": "/zmk-ws",
    "ZMK_PATH": "/zmk-ws/zmk",
    "BUILD_SUBFOLDER": "build"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools", "spadin.zmk-tools"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
